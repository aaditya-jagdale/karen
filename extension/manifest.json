{
  "manifest_version": 3,
  "name": "Karen",
  "version": "1.3.6",
  "description": "Inspect components and save comments locally as a JSON activity list.",
  "author": "Julien Berthomier - Argil.io",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "assets/icons/karen-icon16.png",
    "32": "assets/icons/karen-icon32.png",
    "48": "assets/icons/karen-icon48.png",
    "128": "assets/icons/karen-icon128.png"
  },
  "action": {
    "default_title": "Karen \u2014 Inspect components",
    "default_icon": {
      "16": "assets/icons/karen-icon16.png",
      "32": "assets/icons/karen-icon32.png",
      "48": "assets/icons/karen-icon48.png",
      "128": "assets/icons/karen-icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "options_ui": {
    "page": "storage/storage.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/content.css",
        "assets/fonts/InterVariable.woff2",
        "assets/icons/karen-icon32.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
